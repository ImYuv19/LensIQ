# LensIQ Backend Environment Configuration
# The Ambitious Lens Studio by uvRaj

# Environment & Server
ENVIRONMENT=development
DEBUG=true

# Local Database & Storage
DATABASE_URL=postgresql://localhost:5432/lensiq_local
LOCAL_JWT_SECRET=lensiq-dev-local-jwt-secret-key-32bytes-min!!
LOCAL_STORAGE_DIR=backend/data/documents

# Primary AI Provider: Google Gemini (Generation & 768-dim Embeddings)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=models/gemini-3.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768

# Generation Fallback Provider: Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Google OAuth 2.0 (Optional, for Google Sign-In)
GOOGLE_CLIENT_ID=

# Cloud Supabase (Optional, retained for cloud compatibility)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=documents
